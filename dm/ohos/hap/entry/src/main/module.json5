{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // The dev data import (P2.1): the app pulls the game pack over a loopback channel (hdc fport forwards the
    // device's 127.0.0.1:PORT to the PC, so the pack never rides in a HAP). INTERNET covers loopback http.
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      }
    ],
    // P3.3: GraphicsAccelerateKit's LTPO entry point. HarmonyOS decides whether an app is a game from its store
    // category plus the user's per-game switch, and a sideloaded HAP has neither - so the governor had no idea, and
    // the device's GPU sat at 308 MHz (GpuLoadLevel 1) while Breath of the Wild's frame work took 33 ms. This
    // metadata is the declaration the OpenGTX guide asks for; without it the calls succeed but change nothing.
    "metadata": [
      {
        "name": "GraphicsAccelerateKit_LTPO",
        "value": "true"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "orientation": "landscape",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ]
  }
}
