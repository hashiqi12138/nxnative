+    ('perf_boost', 'DM_GAME_PERF_BOOST', 'int'), ('tex_flush_upload', 'DM_GAME_TEX_FLUSH_UPLOAD', 'int'),
+    ('shader_key_skip_off', 'DM_GAME_SHADER_KEY_SKIP_OFF', 'u64'), ('shader_key_skip_len', 'DM_GAME_SHADER_KEY_SKIP_LEN', 'u64'),
+    ('tex_dirty_upload', 'DM_GAME_TEX_DIRTY_UPLOAD', 'int'), ('tex_dyn_slots', 'DM_GAME_TEX_DYN_SLOTS', 'int'),
+    ('draw_barriers_game', 'DM_GAME_DRAW_BARRIERS_GAME', 'int'), ('upscaler_keys', 'DM_GAME_UPSCALER_KEYS', 'str'),
+    ('upscaler_n', 'DM_GAME_UPSCALER_N', 'int'), ('vconv_range', 'DM_GAME_VCONV_RANGE', 'int'),
+    ('nvn_api_major', 'DM_GAME_NVN_API_MAJOR', 'int'), ('nvn_api_minor', 'DM_GAME_NVN_API_MINOR', 'int'),
