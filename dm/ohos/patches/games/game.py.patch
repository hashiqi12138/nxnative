+]
+RT_LISTS = [('modules', 'DM_GAME_MODULES'), ('builds', 'DM_GAME_BUILD_MODULES'), ('versions', 'DM_GAME_DISPLAY_VERSIONS')]
+CT = {'str': 'const char *', 'u64': 'uint64_t', 'int': 'int'}   # RT_FIELDS' types as C
+
+
+def _macros(g):
+    """header_one's constants by macro name; the ones a profile may leave out are absent."""
+    return {m[1]: m[2] for m in (re.match(r'#define (DM_GAME_\w+) (.*)$', ln) for ln in header_one(g).splitlines()) if m}
+
+
+def _unq(s):
+    """a C string literal's contents, escapes undone (what the runtime struct holds)."""
+    return json.loads(s) if s.startswith('"') else s
+
+
+def _list_items(v):
+    """a brace list's string entries, in order ('' entries dropped, NULL padding is the struct's)."""
+    return [_unq(x) for x in re.findall(r'"(?:[^"\\]|\\.)*"', v or '')]
+
+
+def _default_row(g):
+    """A dm_game_t initializer for the build's own profile: the row a runtime host falls back to when the pack carries no
+    profile.tsv (an older pack). The values are header_one's own C literals, so the fallback is the builtin host exactly."""
+    d = _macros(g)
+    vals = [f'.{f} = {d.get(m, "0")}' for f, m, _ in RT_FIELDS if f != 'nmod']   # nmod comes from the list below
+    mods = _list_items(d.get('DM_GAME_MODULES', ''))
+    vals += ['.nmod = %d' % len(mods), '.modules = { ' + ', '.join(json.dumps(m) for m in mods) + ' }']
+    for field, macro in (('builds', 'DM_GAME_BUILD_MODULES'), ('versions', 'DM_GAME_DISPLAY_VERSIONS')):
+        items = _list_items(d.get(macro, ''))
+        pairs = [(items[i], items[i + 1]) for i in range(0, len(items) - 1, 2)]
+        vals += ['.n%s = %d' % (field, len(pairs)),
+                 '.%s = { %s }' % (field, ', '.join('{ %s, %s }' % (json.dumps(a), json.dumps(b)) for a, b in pairs))]
+    return '{ ' + ', '.join(vals) + ' }'
+
+
+def profile(progs, src):
+    """The runtime profile: one "<field>\\t<value...>" line per constant, per program ("program <n>" starts one). The rows
+    are header_one's own values, so a runtime host and a builtin one cannot disagree; the C parser only reads fields."""
+    by = []
+    for n, g in progs:
+        d = _macros(g)
+        rows = [('program', [str(n)])]
+        for field, macro, typ in RT_FIELDS:
+            v = d.get(macro, '0')
+            rows.append((field, [_unq(v) if typ == 'str' else v.replace('ull', '')]))
+        for field, macro in RT_LISTS:
+            rows.append((field, _list_items(d.get(macro, ''))))
+        by.append(rows)
+    L = [f'# Generated by dm/games/game.py profile from {src}/game.tsv; do not edit',
+         '# <field>\\t<value...>; "program <n>" begins a program\'s block (a multi-program application has several)']
+    for rows in by:
+        for field, vals in rows:
+            L.append(field + ''.join('\t' + str(x) for x in vals))
+    return '\n'.join(L + [''])
+
