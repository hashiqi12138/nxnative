+# The runtime profile (OHOS P4.1): one host for every game. game.py profile writes the constants of header_one as
+# "<field>\t<value...>" rows into the pack, and game.py header --runtime emits a dm_game_t the host fills from those rows.
+# RT_FIELDS is the single list both read: (row name, DM_GAME_* macro, C type). Lists are handled separately below.
+RT_FIELDS = [
