+def header_rt(progs, src):
+    """game_profile.h for a runtime host (OHOS P4.1): the dm_game_t the profile rows fill, and the same DM_GAME_* macros a
+    builtin header defines, reading the running program's entry. The host loads it before anything host-side runs."""
+    L = [f'// Generated by dm/games/game.py header --runtime from {src}/game.tsv; do not edit',
+         '#pragma once', '#include <stdint.h>', '#include <stddef.h>',
+         '#define DM_GAME_RT 1', '#define DM_GAME_MULTI 1',
+         '#define DM_GAME_MAX_PROGRAMS 16', '#define DM_GAME_MAX_MODULES 8',
+         '#define DM_GAME_MAX_BUILDS 4', '#define DM_GAME_MAX_VERSIONS 4',
+         'typedef struct dm_game { int program;',
+         ' '.join(f'{CT[t]} {f};' for f, _, t in RT_FIELDS),
+         ' int nbuilds, nversions;',
+         ' const char *modules[DM_GAME_MAX_MODULES];',
+         ' struct { const char *build, *mods; } builds[DM_GAME_MAX_BUILDS];',
+         ' struct { const char *build, *display; } versions[DM_GAME_MAX_VERSIONS];',
+         '} dm_game_t;',
+         'extern dm_game_t dm_games[DM_GAME_MAX_PROGRAMS];',
+         'extern int dm_n_games;',
+         'const dm_game_t *dm_game_cur(void);   // game_profile_rt.c: the entry of the program DM_PROGRAM names',
+         'int game_profile_load(const char *path);   // 0 = loaded (or fell back to the default), -1 = refused (logged)',
+         # The row a host starts with when the pack carries no profile.tsv (an older pack): the build's own profile, so a
+         # runtime host behaves exactly as a builtin one did before the profile moved out (DESIGN-P4.1 section 5).
+         '#define DM_GAME_DEFAULT_PROFILE ' + _default_row(progs[0][1]),
+         '#define DM_GAME_NGAMES dm_n_games',
+         '#define DM_GAME_FIELD_TABLE(X) ' + ' \\\n    '.join(
+             [f'X(str, {f}, {f})' for f, _, t in RT_FIELDS if t == 'str'] +
+             [f'X(u64, {f}, {f})' for f, _, t in RT_FIELDS if t == 'u64'] +
+             [f'X(int, {f}, {f})' for f, _, t in RT_FIELDS if t == 'int']),
+         '#define DM_GAME_LIST_TABLE(X) ' + ' '.join(f'X({f}, {n})' for f, n in
+                                                  [('modules', 'DM_GAME_MAX_MODULES'), ('builds', 'DM_GAME_MAX_BUILDS'),
+                                                   ('versions', 'DM_GAME_MAX_VERSIONS')])]
+    L += [f'#define {m} (dm_game_cur()->{f})' for f, m, _ in RT_FIELDS]
+    L += ['#define DM_GAME_MODULES { ' + ', '.join(f'dm_game_cur()->modules[{i}]' for i in range(8)) + ' }',
+          '#define DM_GAME_BUILD_MODULES { ' + ', '.join(f'dm_game_cur()->builds[{i}].build, dm_game_cur()->builds[{i}].mods' for i in range(4)) + ' }',
+          '#define DM_GAME_DISPLAY_VERSIONS { ' + ', '.join(f'dm_game_cur()->versions[{i}].build, dm_game_cur()->versions[{i}].display' for i in range(4)) + ' }',
+          '#define DM_GAME_NVERSIONS (dm_game_cur()->nversions)',
+          '']
+    return '\n'.join(L)
+
